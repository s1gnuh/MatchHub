VITE_API_BASE_URL=/api
VITE_API_KEY=your_api_key_here
# Local dev only. On Vercel set FOOTBALL_DATA_KEY (server-side) instead.

# goal-api.com, for the Vietnamese competitions (football-data.org does not carry them).
# Read by the Vite dev proxy; on Vercel and the Cloudflare Worker set GOAL_API_KEY server-side too.
# Leave it out and the app simply shows the other ten competitions.
GOAL_API_KEY=your_goal_api_key_here

# Push notifications — Vercel server-side only, never expose VAPID_PRIVATE_KEY in the browser.
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your@email.com

# Random secret to protect /api/push from unauthorized calls.
# Generate: openssl rand -hex 32
CRON_SECRET=your_cron_secret

# Vercel Blob token — set automatically when you link a Blob store in the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
