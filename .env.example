VITE_API_BASE_URL=/api
VITE_API_KEY=your_api_key_here
# Local dev only. On Vercel set FOOTBALL_DATA_KEY (server-side) instead.

# goal-api.com, for the Vietnamese competitions (football-data.org does not carry them).
# Read by the Vite dev proxy; on Vercel and the Cloudflare Worker set GOAL_API_KEY server-side too.
# Leave it out and the app simply shows the other ten competitions.
GOAL_API_KEY=your_goal_api_key_here
